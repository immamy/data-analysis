- bins = int（指定幾組）
- bins = list（自訂區間）
- bins = 'auto'（自動最佳化）
- bins = 'fd'（Freedman–Diaconis）  # 大數據/有離群值，資料很多（>1000）或很亂，有離群值、偏態分布、真實資料，2*IQR/n^(1/3)，用IQR計算，抗離群值outlier、較準確，bins可能很多
- bins = 'sturges'  # 小樣本（n<200），log2(n) + 1，假設近似常態分布，簡單、穩定，資料多時會過度簡化
- bins = 'sqrt'  # 快速估計，bins ≈ √n，計算快，不精準

- plt.bar() 長條圖 範例  # plt.bar = 垂直柱狀  # plt.barh = 水平柱狀

