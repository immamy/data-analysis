# plt.pie() 圓餅圖
#
sizes = [25, 35, 20, 20]
labels = ['A', 'B', 'C', 'D']
explode = [0, 0.1, 0, 0]  # 第二塊突出
# explode = [0, 0.1, 0, 0.05]  # 第二和第四塊突出

plt.pie(sizes, 
	labels=labels, 
	autopct='%1.1f%%', 
	labeldistance=1.2, 
	# pctdistance=0.7,
	explode=explode,
	# shadow=True,
	# startangle=90,
	wedgeprops={'edgecolor':'black', 'linewidth':1.5}, 
	textprops={'fontsize':12, 'color':'white'},
)
plt.title("Pie chart example")
plt.show()


