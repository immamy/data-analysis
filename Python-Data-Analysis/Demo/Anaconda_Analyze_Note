#
# 👉「怎麼選 bins？」
# 先用 auto 觀察分布，再根據資料特性調整。
# 如果資料量大或有 outliers，會偏向用 fd，因為它基於 IQR，比較 robust。
#
# ✅ 方法1：先用 auto
# plt.hist(data, bins='auto')
# ✅ 方法2：再手動微調
# plt.hist(data, bins=20)
# plt.hist(data, bins=40)

# 常態分布（Normal）  用'sturges' 或 'auto'
# 偏態分布（Skewed）  用 'fd'
# 雙峰分布（Bimodal）  用 'fd' 或 'auto'

# bins = int（指定幾組）
# bins = list（自訂區間）
# bins = 'auto'（自動最佳化）
# bins = 'fd'（Freedman–Diaconis）  # 大數據/有離群值，資料很多（>1000）或很亂，有離群值、偏態分布、真實資料，2*IQR/n^(1/3)，用IQR計算，抗離群值outlier、較準確，bins可能很多
# bins = 'sturges'  # 小樣本（n<200），log2(n) + 1，假設近似常態分布，簡單、穩定，資料多時會過度簡化
# bins = 'sqrt'  # 快速估計，bins ≈ √n，計算快，不精準




