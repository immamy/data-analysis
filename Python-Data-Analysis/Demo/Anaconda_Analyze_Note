#
# Python 基本資料結構
# │
# ├── list        → [1,2,3] → 用len() 👉 元素數量
# ├── dict        → {"A":1} → 用len() 👉 key 的數量
# │👉 list / dict → 可以轉成 Series / DataFrame → 底層是 NumPy array
# │（進階數值處理）
# ↓
# NumPy  import numpy as np
# └── array       → np.array([1,2,3]) → 用len() 👉 列 × 欄（第一維長度row 數，不是總元素數）
#     ↓
# pandas  import pandas as pd
# ├── Series      → 1維（像 list） → 用len() 👉 資料筆數 / size() 👉 總元素數rows × columns  / count() 👉 有效資料數(不含NaN)
# └── DataFrame   → 2維（像 Excel） → 用len() 👉 列數 / size() 👉 總元素數rows × columns  / count() 👉 有效資料數(不含NaN)


# 方法	  list	 dict	array	Series	 DataFrame  
# len()	   ✅	  ✅	 ✅		  ✅		✅      長度
# .size	   ❌	  ❌	 ✅		  ✅		✅      總元素數rows × columns 
# .count() ❌	  ❌	 ❌		  ✅		✅      有效資料數(不含NaN)


# list（Python）👉 可裝任何東西（最基本）
a = [1, 2, None]
len([1,2,3])  # 3 👉 元素數量


# dict（Python）👉 key-value 結構
d = {"A": 1, "B": 2}
len({"A":1,"B":2})  # 2 👉 key 的數量


# array（NumPy）👉 專門做「數值運算」（比 list 強）
import numpy as np
df = np.array([[1,2,3],[4,5,6]]) 
print(len(df))   # 2 👉 2列 × 1欄，（第一維長度row 數，不是總元素數）
print(df.size)     # 6 👉 2列 × 3欄 總元素數rows × columns


# Series（pandas）👉 類似：升級版 list、或 dict（有 index）
import pandas as pd
df = pd.Series([1,2,3]) 
print(len(df))     # 3 👉 資料筆數
print(df.size)     # 3 👉 3列 × 1欄 總元素數rows × columns
print(df.count())  # 3 👉 有效資料數(不含NaN)


# DataFrame（pandas）👉 類似 Excel 表格（2D）
#
df = pd.DataFrame({
    "A": [1, None, 3],
    "B": [4, 5, None]
})
print(len(df))     # 3            👉 列數（rows）
print(df.size)     # 6            👉 3列 × 2欄 總元素數rows × columns
print(df.count())  # 'A':2  'B':2 👉 有效資料數(不含NaN)


#
df.count()       👉 每一欄的非空值數量
df.count(axis=1) 👉 每一列的非空值數量


# groupby 用法
df.groupby(by = 'col').size()   # 👉 回傳 Series（單一數字）
df.groupby(by = 'col').count()  # 👉 回傳 DataFrame（每欄都算）


#
df['col'].value_counts()              # 👉 不含 NaN
df['col'].value_counts(dropna=False)  # 👉 包含 NaN  # 👉 類似：df.groupby('col').size()




